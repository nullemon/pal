# Site host: the Next.js app. CDN host: object storage, with immutable caching for the
# content-addressed covers and pages. In production the CDN host is Cloudflare R2 behind
# Cloudflare's edge; this block is the self-hosted (MinIO) equivalent.

{
	email ops@palscans.org
}

palscans.org, www.palscans.org {
	@www host www.palscans.org
	redir @www https://palscans.org{uri} permanent

	# Uploads go straight to object storage (presigned PUT); the largest body the app itself
	# accepts is the fs-driver stand-in for that PUT (50 MB) — nothing needs more than this.
	request_body {
		max_size 64MB
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Next.js hashed assets are immutable.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# ------------------------------------------------------------------ client address
	#
	# `TRUSTED_PROXY=cloudflare` makes the app read the client address straight off
	# `CF-Connecting-IP` (apps/web/lib/auth/rate-limit.ts). That is correct for a request
	# that came *through* Cloudflare, and forgeable by anyone who can reach this server
	# directly on port 443: one header, and the admin IP allowlist sees an address the
	# attacker chose while every per-IP rate limit keys on a bucket they chose. A
	# pre-launch audit demonstrated both, against this file as it was.
	#
	# `@direct` is "did not arrive from a Cloudflare edge". `remote_ip` matches the socket
	# peer, not a header, so the matcher itself cannot be spoofed. Those requests get the
	# CF-* headers deleted on the way upstream, which leaves `clientIp()` falling through
	# to `X-Forwarded-For`. That header is the real peer and nothing else: with no
	# `trusted_proxies` configured, Caddy *replaces* an inbound X-Forwarded-For with the
	# address it is talking to rather than appending to it — measured against Caddy 2.10.2
	# with `X-Forwarded-For: 9.9.9.9` on the request, which arrived upstream as
	# `x-forwarded-for: 127.0.0.1`. So a forger ends up rate-limiting their own address,
	# and the panel's IP allowlist sees where they are actually connecting from.
	#
	# Two consequences of that replacement worth knowing rather than rediscovering:
	# `TRUSTED_PROXY=xff` is already safe from a forged chain and is untouched by anything
	# in this block (it never reads a CF-* header); and `TRUSTED_PROXY_HOPS` above 1 needs
	# `trusted_proxies` declared on the `reverse_proxy` below, or the chain it counts back
	# through is only ever one entry long.
	#
	# REFRESH THE RANGES. Cloudflare publishes them and they do change:
	#
	#   curl -s https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6
	#
	# A range Cloudflare has added and this file has not is not blocked — it is treated as
	# direct, so those visitors' CF-* headers are dropped and the app sees the edge
	# address instead of theirs. Check it when the certificate renews. Behind a Cloudflare
	# *Tunnel* the peer is `cloudflared` on this host rather than an edge address, so add
	# its address to the list or the tunnel counts as direct.
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	# ------------------------------------------------------------------ origin lockdown
	#
	# Stripping the headers makes forgery useless. Refusing the connection makes the origin
	# invisible, which is the stronger control and the one docs/18 §3 asks you to finish:
	# it also puts the origin out of reach of volumetric floods and of anyone scanning
	# port 443 for the address behind the site.
	#
	# Uncomment the line below **only when Cloudflare is in front** (`TRUSTED_PROXY=
	# cloudflare`). With `xff` — Caddy alone, no Cloudflare — it refuses every real
	# visitor. Keep a way in that does not go through this block (SSH, the server console)
	# before you enable it, and mind the refresh note above: a stale range list turns into
	# a 403 for real traffic rather than a missing header.
	#
	# abort @direct

	handle @direct {
		reverse_proxy web:3000 {
			header_up -CF-Connecting-IP
			header_up -CF-IPCountry
			header_up -CF-IPCity
			header_up -CF-Ray
			header_up -True-Client-IP
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

# ---------------------------------------------------------------------------
# Self-hosted CDN host (MinIO). Commented out because the documented deployment
# uses Cloudflare R2, where cdn.palscans.org is the bucket's custom domain and
# never resolves here.
#
# It must stay commented in that shape, not merely unused: a site block makes
# Caddy try to obtain a certificate for the name, the ACME challenge goes to
# R2's edge instead of this server, and the failures retry forever — burning the
# account's Let's Encrypt failed-authorisation limit, which can then delay
# re-issuing the certificate for palscans.org itself.
#
# Uncomment only when running the `selfhosted` compose profile.
# ---------------------------------------------------------------------------
# cdn.palscans.org {
# 	encode zstd gzip
#
# 	@immutable path /pages/* /covers/*
# 	header @immutable {
# 		Cache-Control "public, max-age=31536000, immutable"
# 		Access-Control-Allow-Origin "https://palscans.org"
# 		X-Content-Type-Options nosniff
# 		-Server
# 	}
#
# 	# Everything else caches briefly. In practice that is /avatars/* and /banners/*: the
# 	# private prefixes (/uploads/*, /sitemaps/*, /_healthcheck/*) are not in MinIO's
# 	# anonymous-download policy, so MinIO refuses them here rather than Caddy.
# 	@other not path /pages/* /covers/*
# 	header @other Cache-Control "public, max-age=300"
#
# 	# Only GET/HEAD reach the bucket; uploads go through presigned URLs on the app host.
# 	@mutating not method GET HEAD OPTIONS
# 	respond @mutating 405
#
# 	# MinIO serves the bucket at /<bucket>/<key>.
# 	rewrite * /palscans{uri}
# 	reverse_proxy minio:9000 {
# 		header_up Host {upstream_hostport}
# 	}
# }
