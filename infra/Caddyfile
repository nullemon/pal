# Site host: the Next.js app. CDN host: object storage, with immutable caching for the
# content-addressed covers and pages. In production the CDN host is Cloudflare R2 behind
# Cloudflare's edge; this block is the self-hosted (MinIO) equivalent.

{
	email ops@palscans.org
}

palscans.org, www.palscans.org {
	@www host www.palscans.org
	redir @www https://palscans.org{uri} permanent

	# Uploads go straight to object storage (presigned PUT); the largest body the app itself
	# accepts is the fs-driver stand-in for that PUT (50 MB) — nothing needs more than this.
	request_body {
		max_size 64MB
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Next.js hashed assets are immutable.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000
}

# ---------------------------------------------------------------------------
# Self-hosted CDN host (MinIO). Commented out because the documented deployment
# uses Cloudflare R2, where cdn.palscans.org is the bucket's custom domain and
# never resolves here.
#
# It must stay commented in that shape, not merely unused: a site block makes
# Caddy try to obtain a certificate for the name, the ACME challenge goes to
# R2's edge instead of this server, and the failures retry forever — burning the
# account's Let's Encrypt failed-authorisation limit, which can then delay
# re-issuing the certificate for palscans.org itself.
#
# Uncomment only when running the `selfhosted` compose profile.
# ---------------------------------------------------------------------------
# cdn.palscans.org {
# 	encode zstd gzip
#
# 	@immutable path /pages/* /covers/*
# 	header @immutable {
# 		Cache-Control "public, max-age=31536000, immutable"
# 		Access-Control-Allow-Origin "https://palscans.org"
# 		X-Content-Type-Options nosniff
# 		-Server
# 	}
#
# 	# Everything else caches briefly. In practice that is /avatars/* and /banners/*: the
# 	# private prefixes (/uploads/*, /sitemaps/*, /_healthcheck/*) are not in MinIO's
# 	# anonymous-download policy, so MinIO refuses them here rather than Caddy.
# 	@other not path /pages/* /covers/*
# 	header @other Cache-Control "public, max-age=300"
#
# 	# Only GET/HEAD reach the bucket; uploads go through presigned URLs on the app host.
# 	@mutating not method GET HEAD OPTIONS
# 	respond @mutating 405
#
# 	# MinIO serves the bucket at /<bucket>/<key>.
# 	rewrite * /palscans{uri}
# 	reverse_proxy minio:9000 {
# 		header_up Host {upstream_hostport}
# 	}
# }
