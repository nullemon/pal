{
  "name": "@palscans/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./storage": { "types": "./dist/storage/index.d.ts", "default": "./dist/storage/index.js" },
    "./queue": { "types": "./dist/queue/index.d.ts", "default": "./dist/queue/index.js" },
    "./comments": { "types": "./dist/comments/index.d.ts", "default": "./dist/comments/index.js" },
    "./messages": { "types": "./dist/messages.d.ts", "default": "./dist/messages.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "bullmq": "^6.3.4",
    "ioredis": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
