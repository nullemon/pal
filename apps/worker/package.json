{
  "name": "@palscans/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@palscans/core": "workspace:*",
    "@palscans/db": "workspace:*",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
