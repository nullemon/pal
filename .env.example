# --- database ---------------------------------------------------------------
# Postgres in production. For local work without Docker, PGlite (embedded
# Postgres) is used automatically when DATABASE_URL starts with pglite://
DATABASE_URL=pglite://./.data/pg
# DATABASE_URL=postgres://pal:pal@localhost:5432/palscans
# DATABASE_POOL_MAX=10        # postgres.js connections per process

# --- cache / queue ----------------------------------------------------------
# Optional locally: when unset, an in-process queue and cache are used.
# REDIS_URL=redis://localhost:6379

# --- object storage ---------------------------------------------------------
# fs (local folder, dev) | s3 (Cloudflare R2 / MinIO / S3)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=palscans
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false   # true for MinIO / clones that need path-style bucket URLs
PUBLIC_CDN_URL=http://localhost:3000/_storage

# --- app --------------------------------------------------------------------
SITE_URL=http://localhost:3000   # must be an https:// origin in production (cookies are Secure)
SITE_NAME=PALScans
# INTERNAL_API_SECRET=   # worker → web /api/internal/revalidate; required in production (dev falls back to SESSION_SECRET)
# 32+ random bytes, base64 (`openssl rand -base64 32`). Production refuses the placeholder.
SESSION_SECRET=change-me-to-32-random-bytes-base64
# Where the client IP comes from (rate limits, hashed session/comment/audit IPs):
#   none        trust no header (default; use when the app is reached directly)
#   xff         the hop the trusted proxy appended to X-Forwarded-For (Caddy/nginx in front)
#   cloudflare  CF-Connecting-IP
# TRUSTED_PROXY=xff           # required in production (xff | cloudflare); per-IP limits depend on it
# TRUSTED_PROXY_HOPS=1        # with `xff`: how many trusted proxies append to the chain

# --- bot protection (optional; unset = every check passes) -------------------
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- worker ------------------------------------------------------------------
# WORKER_CONCURRENCY=1        # chapter.process jobs in flight
# WORKER_PAGE_CONCURRENCY=4   # pages encoded in parallel per job
# WORKER_SCHEDULER_MS=30000   # publish scheduler interval

# --- auth providers (optional locally) ---------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- payments / email (optional locally) -------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
