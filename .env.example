# =============================================================================
# Only the values in this first block belong here. Everything else — R2 keys,
# SMTP, OAuth, Stripe, Turnstile, push, the Discord bot — is entered in
# Admin → System → Integrations and stored (encrypted) in the database.
# See docs/19-credentials.md for why these five cannot move.
# =============================================================================

# --- required in production --------------------------------------------------
# The panel's settings live in the database, so this cannot come from the panel.
DATABASE_URL=pglite://./.data/pg
# DATABASE_URL=postgres://pal:pal@localhost:5432/palscans

# Must be an https:// origin in production — the session cookies are Secure.
SITE_URL=http://localhost:3000
SITE_NAME=PALScans

# 32+ random bytes: `openssl rand -base64 32`. Production refuses the placeholder.
# It also validates the session that lets you into the admin panel, which is why it
# cannot itself live in the panel.
SESSION_SECRET=change-me-to-32-random-bytes-base64

# Worker → web /api/internal/revalidate. Required in production (no fallback).
# INTERNAL_API_SECRET=

# Where the client IP comes from (rate limits, hashed session/comment/audit IPs).
# Security-critical and read before authentication, so it stays out of the panel:
#   none        trust no header (default; the app is reached directly)
#   xff         the hop a trusted proxy appended to X-Forwarded-For (Caddy/nginx)
#   cloudflare  CF-Connecting-IP
# Production requires xff or cloudflare — without it every visitor shares one
# rate-limit bucket and no IP is ever hashed.
# TRUSTED_PROXY=cloudflare
# TRUSTED_PROXY_HOPS=1        # with `xff`: how many trusted proxies append to the chain

# The queue connects at process start, before the database is read.
# Optional locally: unset means an in-process queue and cache.
# REDIS_URL=redis://localhost:6379

# How many web processes to run (apps/web/scripts/serve.mjs, which `pnpm start` and the web
# container both use). Unset or `auto` means one per core — leave it that way. `next start`
# is a single Node process and React server rendering is synchronous work on its event loop,
# so one process serves ~30 reader pages a second whatever the box has: docs/20 measured
# throughput flat from 1 to 32 concurrent readers at 1.07 of 4 cores busy. One per core takes
# the same box from ~30 to ~90-110 pages a second.
#
# Set it only to size down: each worker is a full Next server at ~200-250 MB, so a 2 GB box
# wants 2. `WEB_CONCURRENCY=1` is the old single-process behaviour and the docs/20 baseline.
# One consequence to know: the settings/credentials memo and the proxy snapshot are per
# process, so a change saved in the panel reaches the other workers within 30s (60s for the
# staff path and panel IP allowlist) rather than instantly. The view buffer is per process
# too; Redis and the view_events primary key keep the counting honest regardless.
#
# The *worker* is not affected by this and must stay a single process — it runs schedulers.
# WEB_CONCURRENCY=auto

# --- recommended -------------------------------------------------------------
# Seals the credentials stored in the panel. Falls back to SESSION_SECRET when
# unset — but then rotating SESSION_SECRET makes every stored credential
# unreadable and they must be re-entered. Set this separately to avoid that.
# CREDENTIALS_KEY=

# --- local development only ---------------------------------------------------
# In production these are set in Admin → System → Integrations instead. Values
# here are still read as a fallback, so an existing deployment keeps working and
# can be migrated into the panel one field at a time.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage
PUBLIC_CDN_URL=http://localhost:3000/_storage
# DATABASE_POOL_MAX=10        # postgres.js connections **per process** (its default is 10)
#
# Per process is the part that bites: with WEB_CONCURRENCY web workers the site wants
# WEB_CONCURRENCY × this, plus another pool for the worker, and Postgres refuses the rest with
# `FATAL: sorry, too many clients already` on a random request under load rather than at boot.
# The compose Postgres allows 100 (its `command:` sets max_connections), which is comfortable
# at 4 cores and tight at 8. `preflight.mjs` does the arithmetic and says so.

# --- worker -------------------------------------------------------------------
# WORKER_CONCURRENCY=1        # chapter.process jobs in flight
# WORKER_PAGE_CONCURRENCY=4   # pages encoded in parallel per job
# WORKER_SCHEDULER_MS=30000   # publish scheduler interval
# WORKER_ROLLUP_MS=120000     # how often view_events is rolled into the daily stats
# WORKER_BACKUP_MS=86400000   # how often db.backup is enqueued (24h)

# --- database backups (docs/18 §9, infra/RUNBOOK.md) --------------------------
# Read by the worker only — it is the process with pg_dump and the one that should hold a
# key to the backups bucket. Leave everything unset and the job records "not configured"
# on Admin → System → Backup instead of guessing a destination.
#
# The destination MUST be the second, private R2 bucket from docs/18 §2 — never `palscans`,
# which has cdn.palscans.org attached. The job refuses that one: a dump holds every user
# row, every session and the sealed app_credentials table. Endpoint, region and keys fall
# back to the S3_* values above, so an account-wide token needs only the bucket name.
# BACKUP_S3_BUCKET=palscans-backups
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_FORCE_PATH_STYLE=false
#
# Or write dumps to a directory instead of a bucket (a mounted volume; useful without R2).
# BACKUP_DIR=/var/backups/palscans
#
# BACKUP_PREFIX=pg            # key prefix; the runbook restores from pg/
# BACKUP_RETENTION_DAYS=14    # dumps older than this are deleted after a successful run
# BACKUP_MAX_BYTES=1073741824 # refuse to upload a dump larger than this in one piece
# PG_DUMP=pg_dump             # override if the client is not on PATH
# PG_RESTORE=pg_restore
