# =============================================================================
# Only the values in this first block belong here. Everything else — R2 keys,
# SMTP, OAuth, Stripe, Turnstile, push, the Discord bot — is entered in
# Admin → System → Integrations and stored (encrypted) in the database.
# See docs/19-credentials.md for why these five cannot move.
# =============================================================================

# --- required in production --------------------------------------------------
# The panel's settings live in the database, so this cannot come from the panel.
DATABASE_URL=pglite://./.data/pg
# DATABASE_URL=postgres://pal:pal@localhost:5432/palscans

# Must be an https:// origin in production — the session cookies are Secure.
SITE_URL=http://localhost:3000
SITE_NAME=PALScans

# 32+ random bytes: `openssl rand -base64 32`. Production refuses the placeholder.
# It also validates the session that lets you into the admin panel, which is why it
# cannot itself live in the panel.
SESSION_SECRET=change-me-to-32-random-bytes-base64

# Worker → web /api/internal/revalidate. Required in production (no fallback).
# INTERNAL_API_SECRET=

# Where the client IP comes from (rate limits, hashed session/comment/audit IPs).
# Security-critical and read before authentication, so it stays out of the panel:
#   none        trust no header (default; the app is reached directly)
#   xff         the hop a trusted proxy appended to X-Forwarded-For (Caddy/nginx)
#   cloudflare  CF-Connecting-IP
# Production requires xff or cloudflare — without it every visitor shares one
# rate-limit bucket and no IP is ever hashed.
# TRUSTED_PROXY=cloudflare
# TRUSTED_PROXY_HOPS=1        # with `xff`: how many trusted proxies append to the chain

# The queue connects at process start, before the database is read.
# Optional locally: unset means an in-process queue and cache.
# REDIS_URL=redis://localhost:6379

# --- recommended -------------------------------------------------------------
# Seals the credentials stored in the panel. Falls back to SESSION_SECRET when
# unset — but then rotating SESSION_SECRET makes every stored credential
# unreadable and they must be re-entered. Set this separately to avoid that.
# CREDENTIALS_KEY=

# --- local development only ---------------------------------------------------
# In production these are set in Admin → System → Integrations instead. Values
# here are still read as a fallback, so an existing deployment keeps working and
# can be migrated into the panel one field at a time.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage
PUBLIC_CDN_URL=http://localhost:3000/_storage
# DATABASE_POOL_MAX=10        # postgres.js connections per process

# --- worker -------------------------------------------------------------------
# WORKER_CONCURRENCY=1        # chapter.process jobs in flight
# WORKER_PAGE_CONCURRENCY=4   # pages encoded in parallel per job
# WORKER_SCHEDULER_MS=30000   # publish scheduler interval
